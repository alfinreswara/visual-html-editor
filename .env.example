# Layanan AI harus memakai API yang kompatibel dengan OpenAI.
# Semua variabel ini hanya untuk server. Jangan memakai prefix NEXT_PUBLIC_.

# Base URL tanpa /chat/completions. Default: http://localhost:20128/v1
# Cocok untuk 9router lokal. Provider lain juga bisa dipakai.
AI_BASE_URL=http://localhost:20128/v1

# Wajib diisi. Key hanya dibaca oleh API route di server.
AI_API_KEY=

# Wajib diisi. Contoh: model yang tersedia di 9router atau provider-mu.
AI_MODEL=
